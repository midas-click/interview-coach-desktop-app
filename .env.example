# Notepadder settings
# Copy this to .env and edit as needed.
#
# When running the standalone .exe, place this file next to Notepadder.exe.
# In dev mode, place it in the project root.

# --- transcription ---
# faster-whisper model.  Built-in options:
#   tiny, tiny.en, base, base.en, small, small.en,
#   medium, medium.en, large-v1, large-v2, large-v3
# Or a path to a local model folder (e.g. models/whisper-base)
WHISPER_MODEL=base

# Device: "auto" (uses CUDA if available, else CPU), "cpu", or "cuda"
WHISPER_DEVICE=auto

# Compute type: "int8" for CPU, "float16" for GPU, "int8_float16" for mixed
WHISPER_COMPUTE_TYPE=int8

# --- VAD (voice activity detection) ---
# Speech probability threshold (0.0–1.0).  Higher = fewer false triggers.
VAD_THRESHOLD=0.5

# Silence duration in ms before an utterance endpoint is fired.
VAD_SILENCE_MS=800

# Minimum speech duration in ms before an utterance is considered valid.
# Shorter bursts (clicks, breaths) are discarded.
VAD_MIN_SPEECH_MS=500

# --- output ---
OUTPUT_DIR=./output

# --- temp audio files ---
TEMP_DIR=./data/temp

# --- AWS S3 upload ---
AWS_REGION=us-east-2
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/transcriber.log
