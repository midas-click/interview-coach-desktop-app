# Interview Transcriber settings
# Copy this to .env and fill in your values

# --- transcription ---
WHISPER_MODEL=base

# --- output ---
OUTPUT_DIR=./output

# --- AWS (S3 upload) ---
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/transcriber.log
